# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PODS_SECRET=replace-with-64-hex-characters
PODS_ORIGIN=http://127.0.0.1:8787
PODS_RUNTIME_REPO=RizwanAhamed13/pods-launch-runtime-fresh
PORT=8787
# Enable only after scripts/setup-builder.sh provisions the isolated LXD worker.
PODS_BUILDS_ENABLED=0
# Operator image-store admission budget in bytes (5 GiB). Keep disk headroom for builds.
PODS_IMAGE_STORAGE_BYTES=5368709120
# Optional private GitHub release asset delivery. Set all three together.
# Keep the repository private; the server token needs Contents read/write.
PODS_IMAGE_RELEASE_REPOSITORY=
PODS_IMAGE_RELEASE_ID=
PODS_IMAGE_RELEASE_TOKEN=
# Experimental OCI indexing and launch delivery; disabled until native acceptance.
PODS_IMAGE_REGISTRY_ENABLED=0
# Optional browser OAuth (both values required per provider)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
