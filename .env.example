# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PODS_SECRET=replace-with-64-hex-characters
PODS_ORIGIN=http://127.0.0.1:8787
PODS_RUNTIME_REPO=OWNER/REPOSITORY
PORT=8787
# Optional browser OAuth (both values required per provider)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
